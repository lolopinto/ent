{
  "name": "ent-rsvp",
  "version": "1.0.0",
  "type": "module",
  "description": "ent rsvp example",
  "main": "index.js",
  "scripts": {
    "build:ent": "node ../../scripts/sync_local_ent_packages.mjs",
    "test": "npm run build:ent && NODE_OPTIONS=--experimental-vm-modules jest",
    "compile": "rm -rf dist && ./node_modules/.bin/tsc -p tsconfig.json",
    "start": "docker compose -f docker-compose.dev.yml up --build",
    "codegen": "npm run build:ent && go run ../../../tsent/main.go codegen",
    "upgrade": "npm run build:ent && go run ../../../tsent/main.go upgrade",
    "rebuild-image": "docker compose -f docker-compose.dev.yml build",
    "start-fast": "npm run compile && node dist/graphql/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lolopinto/ent-starter.git"
  },
  "keywords": [
    "ent rsvp"
  ],
  "author": "lolopinto",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/lolopinto/ent-starter/issues"
  },
  "homepage": "https://github.com/lolopinto/ent-starter#readme",
  "dependencies": {
    "@sentry/node": "7.120.4",
    "@sentry/tracing": "7.120.4",
    "@snowtop/ent": "0.2.13",
    "@snowtop/ent-email": "0.1.0",
    "@snowtop/ent-passport": "0.1.0",
    "@snowtop/ent-password": "0.1.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "csv-parse": "4.16.3",
    "dotenv": "8.6.0",
    "express": "4.22.2",
    "glob": "13.0.6",
    "graphql": "16.12.0",
    "graphql-helix": "1.12.0",
    "graphql-upload": "15.0.2",
    "jest-date-mock": "1.0.8",
    "memoizee": "0.4.17",
    "passport": "0.6.0",
    "passport-jwt": "4.0.1"
  },
  "devDependencies": {
    "@snowtop/ent-graphql-tests": "0.1.0",
    "@swc/core": "1.3.100",
    "@types/bcryptjs": "2.4.2",
    "@types/cors": "2.8.12",
    "@types/express": "4.17.13",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.1",
    "@types/passport": "1.0.7",
    "@types/supertest": "7.2.0",
    "jest": "30.4.2",
    "jest-each": "30.4.1",
    "jest-expect-message": "1.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "tsconfig-paths": "3.11.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "diff": "4.0.4",
    "express-session": "1.19.0",
    "jsonwebtoken": "9.0.3",
    "uuid": "11.1.1"
  }
}
