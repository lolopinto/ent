{
  "compilerOptions": {
    "lib": [
      "es2018",
      "esnext.asynciterable"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "target": "es2020",
    "strictNullChecks": true,
    "module": "NodeNext",
    "downlevelIteration": true,
    "baseUrl": ".",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "ent/*": [
        "@snowtop/ent/*"
      ],
      "src/*": [
        "./src/*"
      ],
      "graphql-helix": [
        "./node_modules/graphql-helix/dist/index.d.ts"
      ],
      "dotenv": [
        "./node_modules/dotenv/types/index.d.ts"
      ],
      "*": [
        "*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "tests/**/*"
  ],
  "files": ["node_modules/jest-expect-message/types/index.d.ts"],
}
