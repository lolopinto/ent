{
  "compilerOptions": {
    "lib": ["es2018", "esnext.asynciterable"],
    "rootDir": "src",
    "outDir": "dist",
    "target": "es2020",
    "strictNullChecks": true,
    "module": "NodeNext",
    "downlevelIteration": true,
    "baseUrl": ".",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@snowtop/ent": ["./node_modules/@snowtop/ent"],
      "@snowtop/ent-postgis": ["./node_modules/@snowtop/ent-postgis"],
      "graphql-helix": ["./node_modules/graphql-helix/dist/index.d.ts"],
      "src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "tests/**/*"],
  "files": ["node_modules/jest-expect-message/types/index.d.ts"]
}
