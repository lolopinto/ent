{
  "name": "todo",
  "version": "0.0.1",
  "description": "todo app",
  "main": ".",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build:ent": "node ../scripts/sync_local_ent_packages.mjs",
    "pretest": "npm run build:ent",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "posttest": "npm run test:cjs-runtime",
    "sqlite-test": "docker compose -f docker-compose.dev.yml run --rm -e NODE_OPTIONS=--experimental-vm-modules app ./node_modules/jest/bin/jest.js",
    "compile": "rm -rf dist && ./node_modules/.bin/ent-custom-compiler",
    "test:cjs-runtime": "npm run compile && node scripts/cjs_runtime_smoke.cjs",
    "start": "docker compose -f docker-compose.dev.yml up --build",
    "sqlite-init": "docker compose -f docker-compose.dev.yml run --rm app npm install",
    "codegen": "npm run build:ent && DB_CONNECTION_STRING=sqlite:///todo.db go run ../../tsent/main.go codegen",
    "upgrade": "docker compose -f docker-compose.dev.yml run --rm app tsent upgrade",
    "rebuild-image": "docker compose -f docker-compose.dev.yml build",
    "start-fast": "npm run compile && node dist/graphql/index.js"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "devDependencies": {
    "@snowtop/ent-graphql-tests": "0.1.0",
    "@swc/core": "1.3.100",
    "@types/express": "4.17.13",
    "@types/jest": "30.0.0",
    "@types/jest-expect-message": "1.0.3",
    "@types/luxon": "3.0.1",
    "@types/supertest": "7.2.0",
    "@types/uuid": "11.0.0",
    "jest": "30.4.2",
    "jest-date-mock": "1.0.8",
    "jest-expect-message": "1.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "tsconfig-paths": "3.11.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@snowtop/ent": "0.2.13",
    "@snowtop/ent-phonenumber": "0.1.0",
    "@snowtop/ent-soft-delete": "0.1.0",
    "@types/node": "15.14.9",
    "@types/pg": "8.6.1",
    "better-sqlite3": "12.5.0",
    "express": "4.22.2",
    "graphql": "16.12.0",
    "graphql-helix": "1.12.0",
    "libphonenumber-js": "1.10.37",
    "luxon": "3.7.2"
  },
  "overrides": {
    "diff": "4.0.4",
    "minimatch": "10.2.5",
    "uuid": "11.1.1"
  }
}
