{
  "compilerOptions": {
    "lib": ["es2018", "esnext.asynciterable", "ES2020.String"],
    "rootDir": "src",
    "outDir": "./dist",
    "target": "es2020",
    "strictNullChecks": true,
    "module": "NodeNext",
    "downlevelIteration": true,
    "baseUrl": ".",
    "paths": {
      "@snowtop/ent": ["./node_modules/@snowtop/ent"],
      "src/*": ["src/*"],
      "@snowtop/ent-pgvector": ["./node_modules/@snowtop/ent-pgvector"],
      "graphql-helix": ["./node_modules/graphql-helix/dist/index.d.ts"]
    },
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "types": ["jest", "node"],
    "typeRoots": ["./node_modules/@types", "../../ts/node_modules/@types"],
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
