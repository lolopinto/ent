{
  "name": "simple",
  "version": "0.0.1",
  "description": "simple ts app",
  "main": ".",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build:ent": "npm --prefix ../../ts run compile && cd ../../ts/packages/ent-graphql-tests && ../../node_modules/.bin/tsc -p tsconfig.json && cd ../../../examples/simple && bun scripts/sync_local_ent_packages.ts",
    "test": "npm run build:ent && bun test --preload ./src/testsetup/bun.ts --max-concurrency=1 --timeout 20000",
    "compile": "npm run build:ent && rm -rf dist && bunx ent-custom-compiler",
    "start": "docker compose -f docker-compose.dev.yml up --build",
    "codegen": "npm run build:ent && ENT_RUNTIME=bun ENT_POSTGRES_DRIVER=bun go run ../../tsent/main.go codegen --disable_upgrade",
    "upgrade": "docker compose -f docker-compose.dev.yml run --rm app tsent upgrade",
    "rebuild-image": "docker compose -f docker-compose.dev.yml build",
    "start-fast": "npm run build:ent && bun src/graphql/index.bun.ts",
    "runtime:smoke": "npm run build:ent && ENT_RUNTIME=bun ENT_POSTGRES_DRIVER=bun bun src/scripts/bun_runtime_smoke.ts",
    "typecheck": "npm run build:ent && ./node_modules/.bin/tsc --noEmit"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@snowtop/ent-graphql-tests": "0.1.0",
    "@types/bcryptjs": "2.4.2",
    "@types/bun": "1.3.14",
    "@types/express": "4.17.13",
    "@types/express-session": "1.19.0",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/passport": "1.0.7",
    "@types/supertest": "7.2.0",
    "@types/uuid": "11.0.0",
    "cookie-parser": "1.4.7",
    "jest": "30.4.2",
    "jest-date-mock": "1.0.8",
    "jest-expect-message": "1.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsconfig-paths": "3.11.0"
  },
  "dependencies": {
    "@snowtop/ent": "0.2.13",
    "@snowtop/ent-email": "0.1.0",
    "@snowtop/ent-passport": "0.1.0",
    "@snowtop/ent-password": "0.1.0",
    "@snowtop/ent-phonenumber": "0.1.0",
    "@swc-node/core": "1.10.6",
    "@swc-node/register": "1.6.8",
    "@swc/core": "1.3.100",
    "@types/luxon": "3.2.0",
    "@types/node": "25.9.1",
    "@types/passport-jwt": "3.0.6",
    "@types/passport-local": "1.0.34",
    "@types/passport-strategy": "0.2.35",
    "@types/pg": "8.6.1",
    "bcryptjs": "2.4.3",
    "camel-case": "4.1.2",
    "csv-parse": "4.16.3",
    "dataloader": "2.2.3",
    "express": "4.22.2",
    "express-session": "1.19.0",
    "glob": "13.0.6",
    "graphql": "16.12.0",
    "graphql-helix": "1.13.0",
    "graphql-scalars": "1.22.2",
    "graphql-type-json": "0.3.2",
    "graphql-upload": "15.0.2",
    "jsonwebtoken": "9.0.3",
    "libphonenumber-js": "1.10.37",
    "luxon": "3.7.2",
    "passport": "0.6.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "passport-strategy": "1.0.0",
    "pg": "8.17.2",
    "snake-case": "3.0.4",
    "uuid": "11.1.1"
  },
  "overrides": {
    "diff": "4.0.4",
    "uuid": "11.1.1"
  }
}
