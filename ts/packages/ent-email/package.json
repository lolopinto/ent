{
  "name": "@snowtop/ent-email",
  "version": "0.1.0",
  "type": "module",
  "description": "snowtop ent email datatype",
  "main": "./dist/email.js",
  "types": "./dist/email.d.ts",
  "exports": {
    ".": {
      "types": "./dist/email.d.ts",
      "module-sync": "./dist/email.js",
      "import": "./dist/email.js",
      "require": "./dist/email.js",
      "default": "./dist/email.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:lolopinto/ent.git",
    "directory": "packages/ent-email"
  },
  "keywords": [
    "snowtop",
    "ent",
    "email",
    "datatype"
  ],
  "author": "lolopinto",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lolopinto/ent/issues"
  },
  "homepage": "https://github.com/lolopinto/ent#readme",
  "dependencies": {
    "email-addresses": "5.0.0",
    "libphonenumber-js": "1.10.37"
  },
  "devDependencies": {
    "@snowtop/ent": "0.2.13",
    "@types/jest": "30.0.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@snowtop/ent": ">=0.2.8"
  },
  "overrides": {
    "@snowtop/ent": {
      "brace-expansion": "5.0.6",
      "uuid": "11.1.1"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "diff": "4.0.4"
  }
}
