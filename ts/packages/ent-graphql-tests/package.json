{
  "name": "@snowtop/ent-graphql-tests",
  "version": "0.1.0",
  "type": "module",
  "description": "easy ways to test ent and graphql",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:lolopinto/ent.git",
    "directory": "packages/ent-graphql-tests"
  },
  "keywords": [
    "snowtop",
    "ent",
    "graphql",
    "test"
  ],
  "author": "lolopinto",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lolopinto/ent/issues"
  },
  "homepage": "https://github.com/lolopinto/ent#readme",
  "dependencies": {
    "express": "4.22.2",
    "graphql-helix": "1.13.0",
    "jest-expect-message": "1.1.3",
    "supertest": "7.2.2"
  },
  "devDependencies": {
    "@snowtop/ent": "0.2.13",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "graphql": "16.12.0",
    "graphql-upload": "15.0.2",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@snowtop/ent": ">=0.2.8",
    "graphql": "16.12.0",
    "jest-expect-message": "1.1.3"
  },
  "overrides": {
    "@snowtop/ent": {
      "brace-expansion": "5.0.6",
      "uuid": "11.1.1"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "diff": "4.0.4"
  }
}
