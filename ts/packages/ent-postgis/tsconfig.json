{
  "compilerOptions": {
    "lib": [
      "es2018",
      "esnext.asynciterable"
    ],
    "module": "NodeNext",
    "rootDir": "src",
    "outDir": "./dist",
    "target": "es2018",
    "strictNullChecks": true,
    "downlevelIteration": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "declaration": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "./examples",
    "tests/**/*",
    "src/**/*.test.ts"
  ]
}
